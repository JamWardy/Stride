{
  "openapi": "3.1.0",
  "info": {
    "title": "speedy-tfl",
    "version": "0.1.0"
  },
  "paths": {
    "/options": {
      "get": {
        "summary": "Options",
        "description": "Trains the walker can still catch from ``lat``/``lon``, soonest first.",
        "operationId": "options_options_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "title": "Lon"
            }
          },
          {
            "name": "speed_kmh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 15,
              "exclusiveMinimum": 0,
              "description": "Walking speed",
              "default": 5.5,
              "title": "Speed Kmh"
            },
            "description": "Walking speed"
          },
          {
            "name": "max_walk",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 30,
              "exclusiveMinimum": 0,
              "description": "Longest walk, minutes",
              "default": 12,
              "title": "Max Walk"
            },
            "description": "Longest walk, minutes"
          },
          {
            "name": "risk",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string",
              "default": "medium",
              "title": "Risk"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WalkOption"
                  },
                  "title": "Response Options Options Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stations/search": {
      "get": {
        "summary": "Search Stations",
        "description": "Stations matching ``q``, best match first.",
        "operationId": "search_stations_stations_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Station"
                  },
                  "title": "Response Search Stations Stations Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Station": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "lat",
          "lon"
        ],
        "title": "Station",
        "description": "A station the user can pick as their starting point."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WalkOption": {
        "properties": {
          "station_id": {
            "type": "string",
            "title": "Station Id"
          },
          "station_name": {
            "type": "string",
            "title": "Station Name"
          },
          "line_id": {
            "type": "string",
            "title": "Line Id"
          },
          "line_name": {
            "type": "string",
            "title": "Line Name"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "destination_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination Name"
          },
          "platform_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform Name"
          },
          "departure_time": {
            "type": "string",
            "format": "date-time",
            "title": "Departure Time"
          },
          "walk_seconds": {
            "type": "number",
            "title": "Walk Seconds"
          },
          "wait_seconds": {
            "type": "number",
            "title": "Wait Seconds"
          },
          "margin_seconds": {
            "type": "number",
            "title": "Margin Seconds"
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "station_name",
          "line_id",
          "line_name",
          "direction",
          "destination_name",
          "platform_name",
          "departure_time",
          "walk_seconds",
          "wait_seconds",
          "margin_seconds"
        ],
        "title": "WalkOption",
        "description": "A train the walker can catch by leaving now.\n\n``wait_seconds`` is the time spent on the platform before the train arrives.\n``margin_seconds`` is the slack left after the risk setting's safety margin, i.e. how\nmuch later the walker could leave and still make it at their chosen risk."
      }
    }
  }
}
